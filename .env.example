# Local development settings. On Vercel, set these under Project → Settings → Environment Variables.
# Only RAZORPAY_KEY_ID and the DataFast website id/domain are ever sent to the browser.

APP_ENV=development
DATABASE_URL=sqlite:///./gocrazy.db
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SITE_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business details (footer, Terms, Contact). Required before Razorpay activation.
BUSINESS_NAME=GoCrazy
CONTACT_EMAIL=
BUSINESS_ADDRESS=
JURISDICTION=
LAUNCHED_AT=
DEALS_CLOSES_AT=

# Razorpay. Blank keys enable the local test checkout (development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# DataFast. Stats stay hidden on the site until these are set and data exists.
DATAFAST_API_KEY=
DATAFAST_WEBSITE_ID=
DATAFAST_DOMAIN=
DATAFAST_PUBLIC_STATS_URL=
STATS_CACHE_SECONDS=60
