# Copy to backend/.env. Nothing here is ever sent to the browser except RAZORPAY_KEY_ID.
DATABASE_URL=sqlite:///./gocrazy.db
# DATABASE_URL=postgresql+psycopg://gocrazy:gocrazy@localhost:5432/gocrazy
SITE_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay (Dashboard → Settings → API keys). Leave blank for mock checkout in local dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → add https://<api-host>/webhooks/razorpay, event payment.captured
RAZORPAY_WEBHOOK_SECRET=

# DataFast (Website → Settings → API keys). df_ website key or dft_ account token (needs DATAFAST_WEBSITE_ID).
DATAFAST_API_KEY=
DATAFAST_WEBSITE_ID=
DATAFAST_DOMAIN=
# Public share link from the DataFast dashboard, shown as "Live stats" in the footer.
DATAFAST_PUBLIC_STATS_URL=
STATS_CACHE_SECONDS=60

SEED_DEMO=true
