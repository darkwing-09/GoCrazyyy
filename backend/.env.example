# Local development settings. On Vercel, set these under Project → Settings → Environment Variables.
# Only RAZORPAY_KEY_ID and the DataFast website id/domain are ever sent to the browser.

APP_ENV=development
DATABASE_URL=sqlite:///./gocrazy.db
# For Turso (libSQL):
# TURSO_DATABASE_URL=libsql://gocrazy-username.turso.io
# TURSO_AUTH_TOKEN=your_token_here
# For Postgres (Neon):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SITE_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business details (footer, Terms, Contact). Required before Razorpay activation.
BUSINESS_NAME=GoCrazy
CONTACT_EMAIL=
BUSINESS_ADDRESS=
JURISDICTION=
LAUNCHED_AT=
DEALS_CLOSES_AT=

# Razorpay. Blank keys enable the local test checkout (development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# DataFast (server-side only). Stats stay hidden on the site until real visitors exist.
# DATAFAST_API_KEY: a df_ website key (recommended, least privilege) or a dft_ account token.
# DATAFAST_WEBSITE_ID: optional. With a dft_ token the internal website id is looked up
#   automatically from DATAFAST_DOMAIN; set it only to pin a specific site.
DATAFAST_API_KEY=
DATAFAST_WEBSITE_ID=
DATAFAST_DOMAIN=gocrazyy.vercel.app
DATAFAST_PUBLIC_STATS_URL=
STATS_CACHE_SECONDS=60
